# Vulpes deployment environment template (credentials and environment identity only).
# Copy to .env.local when required by the implementation; NEVER commit populated files.
# Most model behavior belongs in server/config/models.ts (created by Codex), NOT here.

# Public browser values (the VITE_ prefix exposes these in the frontend bundle).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only provider credentials. Never prefix these with VITE_.
OPENROUTER_API_KEY=

# Vertex project identity and runtime location; authenticate with ADC locally
# or workload identity federation on Vercel. Do not commit credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Optional local-only path to an ADC credential file, if needed:
# GOOGLE_APPLICATION_CREDENTIALS=

# Server-only administrative Supabase key, required for private payloads,
# conversation/run transactions and maintenance. Data reads retain user-scoped RLS.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional deployment-specific origin for callbacks / CORS.
VULPES_APP_ORIGIN=http://127.0.0.1:5173

# Defense-in-depth gate: no paid model requests without explicit enablement.
VULPES_LIVE_AI_ENABLED=false

# Required when private trace or import-staging payloads are persisted:
# generate a strong random 32-byte key at setup; keep it server-only.
VULPES_TRACE_ENCRYPTION_KEY_B64=
VULPES_TRACE_ENCRYPTION_KEY_ID=
# Optional JSON object of previous key IDs to base64 keys, for decryption only.
# VULPES_TRACE_PREVIOUS_KEYS_JSON=

# No VULPES_*_MODEL variables, reasoning parameters, feature-flag files,
# or per-user budget constants here. Those belong in reviewed, typed
# application configuration and the database as appropriate.
# See docs/spec/v0.1.0/PROVIDER_SETUP.md for role-specific settings and Vercel OIDC details.
