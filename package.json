{
  "name": "vulpes-health",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "maintenance:cleanup": "tsx scripts/cleanup.ts",
    "dev:client": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "tsx scripts/local-api.ts",
    "dev:full": "concurrently --kill-others --success first npm:dev:api npm:dev:client",
    "preview:client": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:api": "node .build/scripts/local-api.js",
    "preview:full": "concurrently --kill-others --success first npm:preview:api npm:preview:client",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json && tsc -p tsconfig.tools.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.build.json",
    "test": "vitest run",
    "test:bundle": "tsx scripts/check-bundle.ts",
    "test:e2e": "tsx scripts/browser-tests.ts",
    "test:dev": "tsx scripts/browser-tests.ts --dev-proof",
    "test:providers": "tsx scripts/provider-smoke.ts",
    "db:start": "tsx scripts/database.ts start",
    "db:stop": "tsx scripts/database.ts stop",
    "db:reset:test": "tsx scripts/database.ts reset",
    "db:lint": "tsx scripts/database.ts lint",
    "db:types": "tsx scripts/database.ts types",
    "db:types:check": "tsx scripts/database.ts types-check",
    "test:db": "tsx scripts/database.ts test",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.31",
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
