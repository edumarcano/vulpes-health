{
  "name": "vulpes-health",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.18.0",
  "prettier": {
    "singleQuote": true,
    "endOfLine": "lf"
  },
  "scripts": {
    "hosting:prepare": "tsx scripts/prepare-hosting.ts",
    "hosting:probe": "tsx scripts/probe-hosting.ts",
    "hosting:security": "tsx scripts/verify-hosted-security.ts",
    "build:hosted": "tsx scripts/build-hosted.ts",
    "verify:luna": "tsx scripts/verify-luna.ts",
    "budget:provision": "tsx scripts/provision-pilot-budget.ts",
    "evidence:release": "tsx scripts/release-evidence.ts",
    "test:spec": "python docs/spec/v0.1.0/scripts/validate_spec_package.py",
    "maintenance:cleanup": "tsx scripts/cleanup.ts",
    "maintenance:hosted": "tsx scripts/hosted-maintenance.ts",
    "backup:verify": "tsx scripts/backup-verify.ts",
    "recovery:journal": "tsx scripts/recovery-journal.ts",
    "recovery:database": "tsx scripts/hosted-database-recovery.ts",
    "account:recover": "tsx scripts/operator-recover.ts",
    "test:lifecycle-upgrade": "tsx scripts/verify-lifecycle-upgrade.ts",
    "dev:client": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "tsx scripts/local-api.ts",
    "dev:full": "concurrently --kill-others --success first npm:dev:api npm:dev:client",
    "preview:client": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:api": "node .build/scripts/local-api.js",
    "preview:full": "concurrently --kill-others --success first npm:preview:api npm:preview:client",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs}\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json && tsc -p tsconfig.tools.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.build.json",
    "test": "vitest run",
    "test:bundle": "tsx scripts/check-bundle.ts",
    "test:e2e": "tsx scripts/browser-tests.ts",
    "test:pwa": "playwright test --config tests/pwa.config.ts",
    "test:dev": "tsx scripts/browser-tests.ts --dev-proof",
    "test:providers": "tsx scripts/provider-smoke.ts",
    "test:evaluations": "tsx scripts/evaluate-everyday.ts",
    "test:executions": "tsx scripts/execution-proof.ts",
    "test:closeout": "tsx scripts/verify-closeout-local.ts",
    "test:goal-upgrade": "tsx scripts/verify-goal-upgrade.ts",
    "test:execution-upgrade": "tsx scripts/verify-execution-upgrade.ts",
    "db:start": "tsx scripts/database.ts start",
    "db:stop": "tsx scripts/database.ts stop",
    "db:reset:test": "tsx scripts/database.ts reset",
    "db:lint": "tsx scripts/database.ts lint",
    "db:types": "tsx scripts/database.ts types",
    "db:types:check": "tsx scripts/database.ts types-check",
    "test:db": "tsx scripts/database.ts test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:vertex-upgrade": "tsx scripts/verify-vertex-upgrade.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.31",
    "@assistant-ui/react-markdown": "0.14.24",
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.3",
    "decimal.js": "10.6.0",
    "google-auth-library": "11.3.2",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
